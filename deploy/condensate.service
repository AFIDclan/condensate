[Unit]
Description=Condensate game server
After=network-online.target
Wants=network-online.target

[Service]
User=sean
WorkingDirectory=/home/sean/condensate-server
EnvironmentFile=-/home/sean/condensate-server/condensate.env
Environment=CONDENSATE_DATA_DIR=/home/sean/condensate-server/data
Environment=CONDENSATE_BIND=127.0.0.1:8470
ExecStart=/home/sean/condensate-server/bin/condensate-server serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
