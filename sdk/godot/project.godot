; Condensate multiplayer demo. Open this folder in Godot 4.3+ to try it, or copy
; addons/condensate into your own project.

config_version=5

[application]

config/name="Condensate Multiplayer Demo"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Condensate="*res://addons/condensate/condensate.gd"

[condensate]

game_id="condensate-demo"

[display]

window/size/viewport_width=900
window/size/viewport_height=640

[editor_plugins]

enabled=PackedStringArray("res://addons/condensate/plugin.cfg")
