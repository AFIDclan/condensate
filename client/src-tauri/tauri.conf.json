{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Condensate",
  "version": "0.4.0",
  "identifier": "com.condensate.app",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Condensate",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/condensate"
    ],
    "publisher": "Condensate",
    "shortDescription": "Share games with friends",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMEVDMkFDQjE2NjRGNTkKUldSWlQyYXhyTUlPRWlpdlNZZkpXSTc2S3pIOUx4YVpLTGR2OTRDUWovMHZVRVVnVmtRVGhtQkoK",
      "endpoints": [
        "https://oort-cloud.tail4b4a9d.ts.net/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}